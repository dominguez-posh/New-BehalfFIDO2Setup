<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Report.Title"
        Height="860" Width="1360" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Text" Color="#242424"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <SolidColorBrush x:Key="Border" Color="#D0D7DE"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Secondary}"/>
        </Style>
        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#107C41"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,4,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>

        <!-- Traffic light tiles (also the level filter) -->
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="GroupName" Value="LevelFilter"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="6" Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Text" Value="0"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Table -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- Cells are colored by traffic light level; selection wins (last trigger) -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Red">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Yellow">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Green">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Unknown">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="LevelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Red">
                    <Setter Property="Fill" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Yellow">
                    <Setter Property="Fill" Value="#D97706"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Green">
                    <Setter Property="Fill" Value="#16A34A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Uid="Report.Title" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Uid="Report.Subtitle" Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Name="TxtRptTenant" Text="-" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Scope and start -->
            <GroupBox Grid.Row="0" Uid="Report.ScopeGroup">
                <WrapPanel VerticalAlignment="Center">
                    <ComboBox Name="CmbRptScope" Width="300" Padding="8,7" Margin="4" VerticalContentAlignment="Center">
                        <ComboBoxItem Tag="All" Uid="Report.Scope.All" IsSelected="True"/>
                        <ComboBoxItem Tag="Group" Uid="Report.Scope.Members"/>
                    </ComboBox>
                    <StackPanel Name="PnlRptGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox Name="TxtRptGroupSearch" Uid="Report.GroupSearch" Width="200" Margin="4"/>
                        <Button Name="BtnRptFindGroup" Uid="Report.FindGroup" Style="{StaticResource SecondaryButton}"/>
                        <ComboBox Name="CmbRptGroup" Width="260" Padding="8,7" Margin="4" VerticalContentAlignment="Center"
                                  DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                    <CheckBox Name="ChkRptEnabledOnly" Uid="Report.EnabledOnly" IsChecked="True"/>
                    <CheckBox Name="ChkRptGuests" Uid="Report.IncludeGuests"/>
                    <Button Name="BtnRptStart" Uid="Report.Start" Margin="16,4,4,4"/>
                    <Button Name="BtnRptCancel" Uid="Common.Cancel" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
            </GroupBox>

            <!-- Traffic light tiles = level filter -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <RadioButton Name="RbRptAll" Style="{StaticResource Tile}" IsChecked="True">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.All" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountAll" Style="{StaticResource TileCount}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Name="RbRptRed" Uid="Report.Filter.Red" Style="{StaticResource Tile}" Background="#FEE2E2" BorderBrush="#FCA5A5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#DC2626" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.Red" Style="{StaticResource TileLabel}" Foreground="#991B1B"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountRed" Style="{StaticResource TileCount}" Foreground="#991B1B"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Name="RbRptYellow" Uid="Report.Filter.Yellow" Style="{StaticResource Tile}" Background="#FEF3C7" BorderBrush="#FCD34D">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#D97706" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.Yellow" Style="{StaticResource TileLabel}" Foreground="#92400E"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountYellow" Style="{StaticResource TileCount}" Foreground="#92400E"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Name="RbRptGreen" Uid="Report.Filter.Green" Style="{StaticResource Tile}" Background="#DCFCE7" BorderBrush="#86EFAC">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#16A34A" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.Green" Style="{StaticResource TileLabel}" Foreground="#166534"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountGreen" Style="{StaticResource TileCount}" Foreground="#166534"/>
                    </StackPanel>
                </RadioButton>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="2" CornerRadius="6" Padding="14,8" MinWidth="170">
                    <StackPanel>
                        <TextBlock Uid="Report.Tile.AdminsRed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                        <TextBlock Name="TxtRptCountAdminsRed" Style="{StaticResource TileCount}" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="2" CornerRadius="6" Padding="14,8" MinWidth="170" Margin="10,0,0,0"
                        Uid="Report.Tile.InactiveBox">
                    <StackPanel>
                        <TextBlock Name="TxtRptInactiveLabel" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                        <TextBlock Name="TxtRptCountInactive" Style="{StaticResource TileCount}" Foreground="#334155"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Search, filters and export -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="460"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Uid="Report.Search" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Name="TxtRptSearch" Uid="Report.SearchBox" Margin="4"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Name="ChkRptAdminsOnly" Uid="Report.AdminsOnly"/>
                    <CheckBox Name="ChkRptInactiveOnly" Uid="Report.InactiveOnlyBox"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Uid="Report.DoubleClickHint" Style="{StaticResource Label}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0,10,0"/>
                <TextBlock Grid.Column="4" Name="TxtRptVisible" Text="" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="5" Name="BtnRptExport" Uid="Report.Export" IsEnabled="False" Style="{StaticResource ExportButton}"/>
            </Grid>

            <DataGrid Grid.Row="3" Name="DgRpt">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Report.Col.Status" Width="110" SortMemberPath="LevelOrder">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource LevelDot}"/>
                                    <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Report.Col.Reason" Binding="{Binding Reason}" Width="300" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Name" Binding="{Binding DisplayName}" Width="190" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Upn" Binding="{Binding UserPrincipalName}" Width="240" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.LastSignIn" Binding="{Binding LastSignInText}" SortMemberPath="LastSignIn" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.DaysSinceSignIn" Binding="{Binding DaysText}" SortMemberPath="DaysSort" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                        <Setter Property="Foreground" Value="#991B1B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Report.Col.Roles" Binding="{Binding AdminRoles}" Width="220" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Methods" Binding="{Binding Methods}" Width="260" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.GuideSent" Binding="{Binding GuideSentText}" SortMemberPath="GuideSentAt" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding GuideHistoryText}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Report.Col.GuideCount" Binding="{Binding GuideCount}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.MethodCount" Binding="{Binding MethodCount}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Report.Col.Enabled" Binding="{Binding AccountEnabled, Mode=OneWay}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Report.Col.Licensed" Binding="{Binding IsLicensed, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="Report.Col.UserType" Binding="{Binding UserType}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Department" Binding="{Binding Department}" Width="140" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.PasswordLastSet" Binding="{Binding PasswordLastSet}" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Mail" Binding="{Binding Mail}" Width="220" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Name="TxtRptEmpty" Uid="Report.Status.Ready" Style="{StaticResource Label}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer: progress -->
        <Grid Grid.Row="2" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Name="PrgRpt" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Hidden"/>
            <TextBlock Grid.Column="1" Name="TxtRptStatus" Text="" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
