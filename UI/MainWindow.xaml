<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 MFA Administration" Height="900" Width="1280"
        MinHeight="760" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D0D7DE"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E5EA"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#242424"/></Style>
        <Style x:Key="SelectableText" TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#242424"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="#64748B"/><Setter Property="Content" Value="Kopieren"/><Setter Property="IsEnabled" Value="False"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#64748B"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="24,15">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="M365 MFA Administration" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="FIDO2- und TOTP-Provisionierung" Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Name="TxtConnectionStatus" Text="Nicht verbunden" Foreground="#FCA5A5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Name="TxtTenant" Text="Tenant: -" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="1.7*" MinHeight="260"/></Grid.RowDefinitions>
                <GroupBox Header="1. Verbindung"><StackPanel Orientation="Horizontal">
                    <Button Name="BtnLogin" Content="Mit Microsoft 365 anmelden"/>
                    <Button Name="BtnLogout" Content="Abmelden" IsEnabled="False" Background="#64748B"/>
                </StackPanel></GroupBox>
                <GroupBox Grid.Row="1" Header="2. Benutzer suchen"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Name="TxtSearch" ToolTip="Name, UPN oder E-Mail-Adresse" Margin="4"/><Button Name="BtnSearch" Grid.Column="1" Content="Suchen" IsEnabled="False"/>
                </Grid></GroupBox>
                <GroupBox Grid.Row="2" Header="Suchergebnisse"><DataGrid Name="DgUsers" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns><DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*"/><DataGridTextColumn Header="UPN" Binding="{Binding UserPrincipalName}" Width="2*"/><DataGridTextColumn Header="E-Mail" Binding="{Binding Mail}" Width="2*"/><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding AccountEnabled}" Width="70"/></DataGrid.Columns>
                </DataGrid></GroupBox>
                <GroupBox Grid.Row="3" Header="Registrierte MFA-Methoden" Margin="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid Name="DgMethods" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Methode" Binding="{Binding TypeName}" Width="1.6*"/>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding DisplayName}" Width="1.6*"/>
                                <DataGridTextColumn Header="Erstellt am" Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="115"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="Alle Eigenschaften der ausgewählten Methode" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                        <TextBox Grid.Row="2" Name="TxtMethodDetails" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#F8FAFC"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="BtnRefreshMethods" Content="Aktualisieren" IsEnabled="False" Background="#64748B"/>
                            <Button Name="BtnDeleteMethod" Content="Methode löschen" IsEnabled="False" Background="#C42B1C"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
                <GroupBox Header="Ausgewählter Benutzer"><StackPanel>
                    <TextBlock Text="Anzeigename" Style="{StaticResource Label}"/><TextBox Name="TxtSelectedName" Text="-" FontWeight="SemiBold" Style="{StaticResource SelectableText}" Margin="0,2,0,10"/>
                    <TextBlock Text="UPN" Style="{StaticResource Label}"/>
                    <Grid Margin="0,2,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Name="TxtSelectedUpn" Text="-" Style="{StaticResource SelectableText}"/>
                        <Button Grid.Column="1" Name="BtnCopyUpn" Style="{StaticResource CopyButton}" ToolTip="UPN in die Zwischenablage kopieren"/>
                    </Grid>
                    <TextBlock Text="Objekt-ID" Style="{StaticResource Label}"/>
                    <Grid Margin="0,2,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Name="TxtSelectedId" Text="-" Style="{StaticResource SelectableText}"/>
                        <Button Grid.Column="1" Name="BtnCopyId" Style="{StaticResource CopyButton}" ToolTip="Objekt-ID in die Zwischenablage kopieren"/>
                    </Grid>
                    <Separator Margin="0,2,0,10"/>
                    <TextBlock Text="Registrierte Methoden" Style="{StaticResource Label}"/><TextBlock Name="TxtMethodCount" Text="-" Margin="0,2,0,10"/>
                    <TextBlock Text="Bevorzugte MFA-Methode (Benutzer)" Style="{StaticResource Label}"/><TextBlock Name="TxtPreferredMethod" Text="-" Margin="0,2,0,10"/>
                    <TextBlock Text="Systembevorzugte MFA aktiv" Style="{StaticResource Label}"/><TextBlock Name="TxtSystemPreferred" Text="-" Margin="0,2,0,0"/>
                </StackPanel></GroupBox>
                <GroupBox Header="3. Methode konfigurieren"><StackPanel>
                    <ComboBox Name="CmbMethod" Padding="8" Margin="4">
                        <ComboBoxItem Content="FIDO2 Security Key"/>
                        <ComboBoxItem Content="TOTP-Karte mit festem Secret"/>
                        <ComboBoxItem Content="Programmierbare TOTP-Karte"/>
                        <ComboBoxItem Content="Temporary Access Pass (2 Stunden)"/>
                        <ComboBoxItem Content="Fake-MFA (TOTP ohne Hinterlegung)"/>
                    </ComboBox>
                    <StackPanel Name="PnlSerial" Visibility="Collapsed" Margin="4,10,4,0">
                        <TextBlock Name="LblSerial" Text="Seriennummer" Style="{StaticResource Label}"/>
                        <TextBox Name="TxtSerial" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Name="PnlSecret" Visibility="Collapsed" Margin="4,10,4,0">
                        <TextBlock Text="Secret der Karte (Base32, vom Hersteller)" Style="{StaticResource Label}"/>
                        <PasswordBox Name="PwdSecret" Margin="0,4,0,0" Padding="10,8" BorderBrush="#D0D7DE"/>
                    </StackPanel>
                    <TextBlock Name="TxtMethodHint" Text="" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                    <Button Name="BtnExecute" Content="Konfiguration starten" IsEnabled="False" Margin="4,12,4,4"/>
                </StackPanel></GroupBox>
                <Border Name="PnlTap" Visibility="Collapsed" Background="#FFF8E1" BorderBrush="#F2C94C" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Temporary Access Pass" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnHideTap" Content="✕" ToolTip="TAP ausblenden" Padding="8,2" Margin="0" Background="Transparent" Foreground="#64748B"/>
                        </Grid>
                        <TextBlock Name="TxtTapUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Name="TxtTapValue" IsReadOnly="True" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Padding="8,6" Background="White" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnCopyTap" Content="Kopieren" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Name="TxtTapValidity" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Wird nicht protokolliert und ist später nicht mehr abrufbar." Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Name="PnlTotp" Visibility="Collapsed" Background="#FFF8E1" BorderBrush="#F2C94C" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="TOTP-Karte programmieren" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnHideTotp" Content="✕" ToolTip="Secret und QR-Code ausblenden" Padding="8,2" Margin="0" Background="Transparent" Foreground="#64748B"/>
                        </Grid>
                        <TextBlock Name="TxtTotpUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                        <Border Background="White" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8">
                            <Image Name="ImgTotpQr" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock Text="Secret (Base32)" Style="{StaticResource Label}"/>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Name="TxtTotpSecret" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="6,6" Background="White" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnCopyTotpSecret" Content="Kopieren" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Name="TxtTotpInfo" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Button Name="BtnSaveTotpQr" Content="QR-Code speichern …" HorizontalAlignment="Left" Background="#64748B" Margin="0,8,0,0"/>
                        <TextBlock Text="Secret wird nicht protokolliert und ist später nicht mehr abrufbar. Nach dem Programmieren ausblenden." Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <GroupBox Header="Protokoll" Height="240" Margin="0"><TextBox Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"/></GroupBox>
            </StackPanel></ScrollViewer>
        </Grid>
        <Grid Grid.Row="2"><ProgressBar Name="ProgressBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/><TextBlock Text="Administrative Aktionen nur gemäß Freigabe- und Sicherheitsprozess durchführen." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Grid>
</Window>
