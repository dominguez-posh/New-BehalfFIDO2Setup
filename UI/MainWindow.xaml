<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 MFA Administration"
        Height="900" Width="1280" MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Farben -->
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
        <SolidColorBrush x:Key="Text" Color="#242424"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <SolidColorBrush x:Key="Border" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="ResultBackground" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="ResultBorder" Color="#F2C94C"/>

        <!-- Standardstile -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <!-- Tabellen: flach, weiß, dezente Linien und Auswahl -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Benannte Stile -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Secondary}"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Content" Value="Kopieren"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="{StaticResource ResultBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ResultBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="M365 MFA Administration" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="FIDO2-, TOTP- und TAP-Provisionierung" Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Name="TxtConnectionStatus" Text="Nicht verbunden" Foreground="#FCA5A5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Name="TxtTenant" Text="Tenant: -" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnBreakGlass" Content="Breakglass-Account …" IsEnabled="False" Style="{StaticResource HeaderButton}"
                            ToolTip="Neuen Breakglass-Account mit FIDO2-Stick anlegen"/>
                    <Button Name="BtnLogin" Content="Anmelden"/>
                    <Button Name="BtnLogout" Content="Abmelden" IsEnabled="False" Style="{StaticResource HeaderButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte: Suche (Ergebnisse als Popup) und MFA-Methoden -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="1. Benutzer suchen">
                    <Grid Name="SearchPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TxtSearch" Margin="4" ToolTip="Name, UPN, E-Mail-Adresse oder Objekt-ID - Enter startet die Suche"/>
                        <Button Name="BtnSearch" Grid.Column="1" Content="Suchen" IsEnabled="False"/>

                        <!-- Suchergebnisse klappen unter dem Suchfeld auf -->
                        <Popup Name="PopUsers" PlacementTarget="{Binding ElementName=SearchPanel}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=SearchPanel}"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Margin="0,4,8,8" Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Name="TxtUserHits" Text="" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                                    <DataGrid Name="DgUsers" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="UPN" Binding="{Binding UserPrincipalName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="E-Mail" Binding="{Binding Mail}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding AccountEnabled}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Name="GrpMethods" Header="2. Registrierte MFA-Methoden" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.3*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Name="DgMethods">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Methode" Binding="{Binding TypeName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding DisplayName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Erstellt am" Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="115" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Name="TxtNoUser" Text="Bitte oben einen Benutzer suchen und auswählen."
                                   Style="{StaticResource Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Alle Eigenschaften der ausgewählten Methode" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                        <TextBox Grid.Row="2" Name="TxtMethodDetails" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="11" Background="#F8FAFC"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="BtnRefreshMethods" Content="Aktualisieren" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                            <Button Name="BtnDeleteMethod" Content="Methode löschen" IsEnabled="False" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Rechte Spalte: Benutzer, Konfiguration, Ergebnisse, Protokoll -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <GroupBox Header="Ausgewählter Benutzer">
                        <StackPanel>
                            <TextBlock Text="Anzeigename" Style="{StaticResource Label}"/>
                            <TextBox Name="TxtSelectedName" Text="-" FontWeight="SemiBold" Style="{StaticResource SelectableText}" Margin="0,2,0,10"/>

                            <TextBlock Text="UPN" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedUpn" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyUpn" Style="{StaticResource CopyButton}" ToolTip="UPN in die Zwischenablage kopieren"/>
                            </Grid>

                            <TextBlock Text="Objekt-ID" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedId" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyId" Style="{StaticResource CopyButton}" ToolTip="Objekt-ID in die Zwischenablage kopieren"/>
                            </Grid>

                            <Separator Margin="0,2,0,10"/>

                            <!-- MFA-Ampel -->
                            <TextBlock Text="MFA-Status" Style="{StaticResource Label}"/>
                            <Border Name="BdgMfa" CornerRadius="12" Padding="10,4" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Name="DotMfa" Width="10" Height="10" Fill="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Name="TxtMfaLevel" Text="-" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Name="TxtMfaHints" Text="" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="2,6,0,10" Visibility="Collapsed"/>

                            <!-- Administrative Rollen -->
                            <TextBlock Text="Administrative Rollen" Style="{StaticResource Label}" Margin="0,4,0,0"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="TxtRoleSummary" Text="-" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnShowRoles" Content="Anzeigen" Style="{StaticResource CopyButton}" Visibility="Collapsed"
                                        ToolTip="Rollen ein-/ausblenden"/>
                            </Grid>
                            <ItemsControl Name="LstRoles" Visibility="Collapsed" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="#64748B">
                                                    <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Scope, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Registrierte Methoden" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtMethodCount" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Text="Bevorzugte MFA-Methode (Benutzer)" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtPreferredMethod" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Text="Systembevorzugte MFA aktiv" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtSystemPreferred" Text="-" Margin="0,2,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="3. Methode konfigurieren">
                        <StackPanel>
                            <ComboBox Name="CmbMethod" Padding="8" Margin="4">
                                <ComboBoxItem Content="FIDO2 Security Key"/>
                                <ComboBoxItem Content="TOTP-Karte mit festem Secret"/>
                                <ComboBoxItem Content="Programmierbare TOTP-Karte"/>
                                <ComboBoxItem Content="Temporary Access Pass (2 Stunden)"/>
                                <ComboBoxItem Content="Fake-MFA (TOTP ohne Hinterlegung)"/>
                            </ComboBox>
                            <StackPanel Name="PnlSerial" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Name="LblSerial" Text="Seriennummer" Style="{StaticResource Label}"/>
                                <TextBox Name="TxtSerial" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Name="PnlSecret" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Text="Secret der Karte (Base32, vom Hersteller)" Style="{StaticResource Label}"/>
                                <PasswordBox Name="PwdSecret" Margin="0,4,0,0" Padding="10,8" BorderBrush="{StaticResource Border}"/>
                            </StackPanel>
                            <TextBlock Name="TxtMethodHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                            <Button Name="BtnExecute" Content="Konfiguration starten" IsEnabled="False" Margin="4,12,4,4"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Ergebnis: Temporary Access Pass -->
                    <Border Name="PnlTap" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Temporary Access Pass" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTap" Style="{StaticResource CloseButton}" ToolTip="TAP ausblenden"/>
                            </Grid>
                            <TextBlock Name="TxtTapUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTapValue" IsReadOnly="True" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                         Padding="8,6" Background="White" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTap" Content="Kopieren" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTapValidity" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Wird nicht protokolliert und ist später nicht mehr abrufbar." Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Ergebnis: programmierbare TOTP-Karte -->
                    <Border Name="PnlTotp" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTP-Karte programmieren" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTotp" Style="{StaticResource CloseButton}" ToolTip="Secret und QR-Code ausblenden"/>
                            </Grid>
                            <TextBlock Name="TxtTotpUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Border Background="White" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8">
                                <Image Name="ImgTotpQr" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock Text="Secret (Base32)" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTotpSecret" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                         Padding="6,6" Background="White" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTotpSecret" Content="Kopieren" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTotpInfo" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button Name="BtnSaveTotpQr" Content="QR-Code speichern …" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Text="Secret wird nicht protokolliert und ist später nicht mehr abrufbar. Nach dem Programmieren ausblenden."
                                       Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Header="Protokoll" Height="240" Margin="0">
                        <TextBox Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Fußzeile mit Fortschrittsanzeige -->
        <Grid Grid.Row="2">
            <ProgressBar Name="ProgressBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
            <TextBlock Text="Administrative Aktionen nur gemäß Freigabe- und Sicherheitsprozess durchführen."
                       FontSize="11" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
