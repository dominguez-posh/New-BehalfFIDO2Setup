<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 MFA Administration"
        Height="900" Width="1280" MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Farben -->
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
        <SolidColorBrush x:Key="Text" Color="#242424"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <SolidColorBrush x:Key="Border" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="ResultBackground" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="ResultBorder" Color="#F2C94C"/>

        <!-- Standardstile -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Benannte Stile -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Secondary}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Content" Value="Kopieren"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="{StaticResource ResultBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ResultBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="M365 MFA Administration" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="FIDO2-, TOTP- und TAP-Provisionierung" Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Name="TxtConnectionStatus" Text="Nicht verbunden" Foreground="#FCA5A5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Name="TxtTenant" Text="Tenant: -" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte: Verbindung, Suche, Ergebnisse, MFA-Methoden -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="1.7*" MinHeight="260"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="1. Verbindung">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="BtnLogin" Content="Mit Microsoft 365 anmelden"/>
                        <Button Name="BtnLogout" Content="Abmelden" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="2. Benutzer suchen">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TxtSearch" Margin="4" ToolTip="Name, UPN, E-Mail-Adresse oder Objekt-ID"/>
                        <Button Name="BtnSearch" Grid.Column="1" Content="Suchen" IsEnabled="False"/>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Suchergebnisse">
                    <DataGrid Name="DgUsers">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="UPN" Binding="{Binding UserPrincipalName}" Width="2*"/>
                            <DataGridTextColumn Header="E-Mail" Binding="{Binding Mail}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding AccountEnabled}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="Registrierte MFA-Methoden" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Name="DgMethods">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Methode" Binding="{Binding TypeName}" Width="1.6*"/>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding DisplayName}" Width="1.6*"/>
                                <DataGridTextColumn Header="Erstellt am" Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="115"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="Alle Eigenschaften der ausgewählten Methode" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                        <TextBox Grid.Row="2" Name="TxtMethodDetails" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="11" Background="#F8FAFC"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="BtnRefreshMethods" Content="Aktualisieren" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                            <Button Name="BtnDeleteMethod" Content="Methode löschen" IsEnabled="False" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Rechte Spalte: Benutzer, Konfiguration, Ergebnisse, Protokoll -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <GroupBox Header="Ausgewählter Benutzer">
                        <StackPanel>
                            <TextBlock Text="Anzeigename" Style="{StaticResource Label}"/>
                            <TextBox Name="TxtSelectedName" Text="-" FontWeight="SemiBold" Style="{StaticResource SelectableText}" Margin="0,2,0,10"/>

                            <TextBlock Text="UPN" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedUpn" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyUpn" Style="{StaticResource CopyButton}" ToolTip="UPN in die Zwischenablage kopieren"/>
                            </Grid>

                            <TextBlock Text="Objekt-ID" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedId" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyId" Style="{StaticResource CopyButton}" ToolTip="Objekt-ID in die Zwischenablage kopieren"/>
                            </Grid>

                            <Separator Margin="0,2,0,10"/>

                            <TextBlock Text="Registrierte Methoden" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtMethodCount" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Text="Bevorzugte MFA-Methode (Benutzer)" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtPreferredMethod" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Text="Systembevorzugte MFA aktiv" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtSystemPreferred" Text="-" Margin="0,2,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="3. Methode konfigurieren">
                        <StackPanel>
                            <ComboBox Name="CmbMethod" Padding="8" Margin="4">
                                <ComboBoxItem Content="FIDO2 Security Key"/>
                                <ComboBoxItem Content="TOTP-Karte mit festem Secret"/>
                                <ComboBoxItem Content="Programmierbare TOTP-Karte"/>
                                <ComboBoxItem Content="Temporary Access Pass (2 Stunden)"/>
                                <ComboBoxItem Content="Fake-MFA (TOTP ohne Hinterlegung)"/>
                            </ComboBox>
                            <StackPanel Name="PnlSerial" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Name="LblSerial" Text="Seriennummer" Style="{StaticResource Label}"/>
                                <TextBox Name="TxtSerial" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Name="PnlSecret" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Text="Secret der Karte (Base32, vom Hersteller)" Style="{StaticResource Label}"/>
                                <PasswordBox Name="PwdSecret" Margin="0,4,0,0" Padding="10,8" BorderBrush="{StaticResource Border}"/>
                            </StackPanel>
                            <TextBlock Name="TxtMethodHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                            <Button Name="BtnExecute" Content="Konfiguration starten" IsEnabled="False" Margin="4,12,4,4"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Ergebnis: Temporary Access Pass -->
                    <Border Name="PnlTap" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Temporary Access Pass" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTap" Style="{StaticResource CloseButton}" ToolTip="TAP ausblenden"/>
                            </Grid>
                            <TextBlock Name="TxtTapUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTapValue" IsReadOnly="True" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                         Padding="8,6" Background="White" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTap" Content="Kopieren" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTapValidity" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Wird nicht protokolliert und ist später nicht mehr abrufbar." Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Ergebnis: programmierbare TOTP-Karte -->
                    <Border Name="PnlTotp" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTP-Karte programmieren" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTotp" Style="{StaticResource CloseButton}" ToolTip="Secret und QR-Code ausblenden"/>
                            </Grid>
                            <TextBlock Name="TxtTotpUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Border Background="White" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8">
                                <Image Name="ImgTotpQr" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock Text="Secret (Base32)" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTotpSecret" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                         Padding="6,6" Background="White" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTotpSecret" Content="Kopieren" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTotpInfo" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button Name="BtnSaveTotpQr" Content="QR-Code speichern …" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Text="Secret wird nicht protokolliert und ist später nicht mehr abrufbar. Nach dem Programmieren ausblenden."
                                       Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Header="Protokoll" Height="240" Margin="0">
                        <TextBox Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Fußzeile mit Fortschrittsanzeige -->
        <Grid Grid.Row="2">
            <ProgressBar Name="ProgressBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
            <TextBlock Text="Administrative Aktionen nur gemäß Freigabe- und Sicherheitsprozess durchführen."
                       FontSize="11" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
