<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Guide.Title"
        Width="860" Height="900" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="Guide.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Uid="Guide.Subtitle" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E1E5EA" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Uid="Guide.To" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="1" Name="TxtGuideTo" Text="-" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Uid="Guide.From" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtGuideFrom" Uid="Guide.FromBox" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Uid="Guide.Language" Style="{StaticResource Label}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Name="CmbGuideLanguage" Width="180" Padding="8,5" VerticalAlignment="Center" DisplayMemberPath="Name"/>
                    <TextBlock Name="TxtGuideLanguageHint" Text="" FontSize="12" Foreground="#64748B" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Uid="Guide.Subject" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtGuideSubject" Text="-" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="24,14,24,0" BorderBrush="#D0D7DE" BorderThickness="1">
            <WebBrowser Name="WebGuidePreview"/>
        </Border>

        <Grid Grid.Row="3" Margin="24,12,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="TxtGuideInfo" Uid="Guide.AttributeHint" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnGuideCancel" Uid="Common.Cancel" Background="#64748B" IsCancel="True"/>
                <Button Name="BtnGuideSend" Uid="Guide.Send" IsDefault="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
